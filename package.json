{
  "name": "pi-markdown-rendering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extension that shows h3-h6 headings without # marks and fits wide Mermaid diagrams",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks",
    "complexity": "eslint src"
  },
  "dependencies": {
    "grok-mermaid": "0.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
